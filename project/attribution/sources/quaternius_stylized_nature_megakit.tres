[gd_resource type="Resource" script_class="AttributionEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://attribution/attribution_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = "quaternius_stylized_nature_megakit"
creator = "Quaternius"
source_name = "Stylized Nature MegaKit (Standard/free)"
source_version = "Standard edition — 68 of 116 total pack models"
creator_url = "https://quaternius.com"
source_url = "https://quaternius.com"
support_url = "https://www.patreon.com/quaternius"
license_name = "CC0 1.0 Universal (CC0 1.0) Public Domain Dedication"
license_url = "https://creativecommons.org/publicdomain/zero/1.0/"
license_file = "res://assets/licenses/Quaternius_UltimateAnimatedAnimals_License.txt"
attribution_required = false
required_notice = ""
conditions = ""
assets_used = PackedStringArray("CommonTree_1", "CommonTree_2", "Grass_Common_Short", "Grass_Common_Tall", "Flower_3_Group", "Flower_4_Group", "Bush_Common_Flowers", "Fern_1", "Grass_Wispy_Short")
per_file_licensing = false
notes = "CC0 — crediting is courtesy, not compliance. Reuses the generic Quaternius CC0
license text already in-repo (`License_Standard.txt` in this pack is the same generic
CC0 1.0 dedication, just with an extra paragraph noting this is the free Standard tier
vs. the paid PRO/SOURCE tiers — that paragraph is a marketing note, not a license term).

First use of this pack: 2 common trees + 2 common grass variants for the terrain
common-set pass (project/assets/terrain/). Unlike the animal/building imports, these
scale corrections are NOT measured against a GDD number — there is no stated tile-height
target for trees or grass the way there is for a villager (\"~1 tile tall\") or a house
footprint. Flagged for human eyeball sign-off in each wrapper scene's own header comment.

Each imported glTF references external PNG textures (Bark_NormalTree*, Leaves_NormalTree_C,
Grass) copied alongside it into its own asset folder — self-contained per the pipeline's
one-folder-per-asset convention, at the cost of duplicating shared textures across folders.

Second use (2026-09-04, habitat-tiers Task 8): 5 new pieces imported for the Meadow and
Scrub terrains (task-8-brief.md) — Flower_3_Group.gltf and Flower_4_Group.gltf composed
into project/assets/terrain/meadow/Meadow.tscn (the new `flowers` habitat tag's first
source); Bush_Common_Flowers.gltf, Fern_1.gltf, and Grass_Wispy_Short.gltf composed into
project/assets/terrain/scrub/Scrub.tscn (the new `browse` habitat tag's source). Each
imported into its own asset folder under project/assets/terrain/ with its referenced PNG
textures copied alongside (Leaves.png/Flowers.png for the flower groups and Fern_1;
Leaves_NormalTree_C.png/Flowers.png for Bush_Common_Flowers; Grass.png for
Grass_Wispy_Short) — same self-contained-per-folder convention as the first use, at the
same cost of duplicating shared textures across folders. See each terrain wrapper scene's
own header for full sourcing/scale detail.

Pack ships many more trees/rocks/grass/flowers not evaluated here; append to assets_used
as more are imported, do NOT create a second entry for this pack (same convention as the
other Quaternius entries)."
