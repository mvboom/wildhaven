; THE ROOT CONTROL. Full-rect, MOUSE_FILTER_IGNORE — it exists only to anchor `LeaveArea`, and
; must never itself block a world tap (the negative control in test_mode_tap_model.gd sets this
; to MOUSE_FILTER_STOP and asserts the widened scan reports it).
[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; Bottom-right corner (terraform-bar rework vacated this spot when the HUD's Home button was
; retired and Rotate moved into the merged palette row) — a plain square icon button now,
; matching the rest of the bottom chrome instead of the old wide text pill.
