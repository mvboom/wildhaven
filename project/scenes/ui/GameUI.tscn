; Added BEFORE the fact card/displacement notice — row 12's toast is the lowest-priority
; surface in the stack (a bulletin about the world in general, never consent and never the
; move-in payoff), so it must never draw on top of either.
[node name="NewsReportToast" parent="." instance=ExtResource("8")]
unique_name_in_owner = true

[node name="FactCard" parent="." instance=ExtResource("5")]
unique_name_in_owner = true

; Added AFTER the fact card so the row-10 warning draws on top of it. Both can be up at once —
; a move-in and a settlement are independent events — and consent outranks flavour.
[node name="DisplacementNotice" parent="." instance=ExtResource("6")]
unique_name_in_owner = true

[node name="NotificationFeed" parent="." instance=ExtResource("14")]
unique_name_in_owner = true

; Task 7 — the onboarding coach's chip. Added AFTER NotificationFeed so it draws above the HUD
; (and above NotificationFeed's own entries, which never compete for the same screen real
; estate the coach points at), but BEFORE MenuWindow below: `GameUI._process()` already refuses
; to show a new chip while a modal is open (the same suppression `Crosshair` applies), and this
; draw order means even a chip already on screen the instant a modal opens is covered by it
; rather than floating on top, belt-and-suspenders with that script-side check.
[node name="CoachChip" parent="." instance=ExtResource("17")]
unique_name_in_owner = true

; Added LAST, on top of everything else — the player opened this deliberately (a HUD tap),
; unlike the fact card or the displacement notice, which the simulation fires at them. Task 5
; folded the standalone FieldGuide/CatalogPanel/SettingsOverlay overlays into this single
; window's tabs (Terrain, Buildings, Field Guide, Settings) — one shell instead of three.
[node name="MenuWindow" parent="." instance=ExtResource("13")]
unique_name_in_owner = true

[node name="TapRouter" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4")

