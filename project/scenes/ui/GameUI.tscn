theme_override_constants/separation = 10

; InspectButton ("Look") is declared here, not built in script — the one hand-authored child
; PaletteRow starts with. GameHud's `_add_palette_button()` inserts every catalog button, then
; the fixed Erase button, immediately before whichever child currently sits at Erase's own
; index — so pre-authoring Look as the row's ONLY starting child guarantees it stays leftmost
; (key "0", read before key "1") without any index bookkeeping in the script.
[node name="InspectButton" type="Button" parent="HUD/PaletteRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("ButtonCream")

; Bottom-left corner (Task 5) — the only free corner: WoodPanel already owns top-left,
; PaletteRow owns bottom-center, BottomRight/Exit own bottom-right. Declared directly on HUD,
; not inside PaletteRow, so it can never be mistaken for catalog content or shift a palette
; index — Tab already opens the Field Guide (Task 4); this is the second, discoverable door to
; the same room for a player who has never used a keyboard shortcut. `offset_left = 24.0`
; matches WoodPanel's own top-left inset, so the two read as a matched pair of corner buttons.
[node name="HelpButton" type="Button" parent="HUD"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 72)
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -96.0
offset_right = 96.0
offset_bottom = -24.0
grow_vertical = 0
focus_mode = 0
theme_override_styles/normal = SubResource("ButtonCream")

[node name="Icon" type="Control" parent="HUD/HelpButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("16")
kind = 10

; Bottom-right corner, positioned to sit immediately left of `LeaveOverlay`'s Exit button (its
; own separate CanvasLayer/scene — see that file's header for why it stays a sibling rather
; than folding in here) so the two read as one cluster despite being different scenes. Exit
; occupies offset_right -24 to offset_left -96 (a 72px button, 24px corner margin); this
; container's own offset_right -106 leaves a 10px gap, matching PaletteRow's own separation.
[node name="BottomRight" type="HBoxContainer" parent="HUD"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -96.0
offset_right = -106.0
offset_bottom = -24.0
grow_horizontal = 0
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 10

