[gd_scene load_steps=2 format=3]

; Task 7 — the onboarding coach's one visible element. See scripts/ui/coach_chip.gd.
;
; LAYOUT MIRRORS `NotificationFeed._make_entry()` EXACTLY, for the same reason: `PanelContainer`
; forces every DIRECT child to fill its whole content rect, so a `Dismiss` button parented
; straight onto `Panel` would be stretched panel-tall instead of sitting compact in a corner.
; `Panel` holds two direct children instead — `Content` (a `MarginContainer` that reserves a
; right-hand gutter so no wrapped line of `Label` ever runs under the button) and `Overlay` (a
; mouse-ignoring, zero-visual `Control` that Panel ALSO stretches to its full rect — harmless,
; since Overlay draws nothing — and it is THAT stretched rect `Dismiss` anchors its top-right
; corner against, landing correctly in the panel's actual corner).
;
; `Panel` itself is anchored to a single point (preset 0, top-left, unstretched) rather than
; spanning two edges, so its rendered size comes from its own minimum size (content + the
; reserved gutter) — `coach_chip.gd::_process()` reads `_panel.size` every frame to centre it
; over the target button, which only gives a meaningful answer if the panel is sized to its
; content rather than stretched to fill this root's full-rect Control.
;
; Every colour/style override happens at runtime in `coach_chip.gd::_ready()` (`UiPalette` is
; the one authority) — this file only lays out structure and reserves the dismiss gutter, which
; the script has no hook to compute (there is no `_ready()`-time pass here, unlike
; `NotificationFeed`, which builds this same structure in script and can size it there).

[ext_resource type="Script" path="res://scripts/ui/coach_chip.gd" id="1"]

[node name="CoachChip" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 1
anchors_preset = 0
mouse_filter = 2

; Reserves room for `Dismiss` (72px, matching `NotificationFeed`'s own `HIT_TARGET`-wide hit
; area) plus a 12px gutter — the same two numbers `notification_feed.gd::_make_entry()` uses
; (`button_size` + `DISMISS_GUTTER`) — so no wrapped line of `Label` ever runs under the button.
[node name="Content" type="MarginContainer" parent="Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_right = 84

[node name="Label" type="Label" parent="Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
autowrap_mode = 3

[node name="Overlay" type="Control" parent="Panel"]
mouse_filter = 2

[node name="Dismiss" type="Button" parent="Panel/Overlay"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 72)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -72.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 72.0
grow_horizontal = 0
focus_mode = 0
