; Water — GREY-BOX PLACEHOLDER. Authored in-repo from Godot primitives; no third-party
; source, nothing to attribute (see assets/placeholder/README.md).
;
; A flat opaque slab, NOT a water shader. content-pipeline-status.md records the real
; water surface as "a shader/plane" with Nature Pack edge dressing; none of that is
; sourced yet, and a grey-box must not pretend to be it.
;
; Slab dimensions track grid_manager.gd (0.94 across, TILE_HEIGHT 0.2 thick). The slab is
; dropped 0.04 below the other terrains so a water tile reads as slightly recessed — a
; free legibility win at grey-box stage, and a PLACEHOLDER like everything else here.
;
; COLOUR IS A PLACEHOLDER and a taste call reserved for the human: Color(0.24, 0.48, 0.72).
[gd_scene load_steps=3 format=3]

[sub_resource type="BoxMesh" id="BoxMesh_slab"]
size = Vector3(0.94, 0.2, 0.94)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_slab"]
albedo_color = Color(0.24, 0.48, 0.72, 1)

[node name="Water" type="Node3D"]

[node name="Slab" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.14, 0)
mesh = SubResource("BoxMesh_slab")
material_override = SubResource("StandardMaterial3D_slab")
