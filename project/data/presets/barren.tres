[gd_resource type="Resource" script_class="WorldPreset" load_steps=2 format=3]

; `terrain_mix` IS EMPTY ON PURPOSE — this is the one card that keeps the pre-D-53 world.
; An empty mix means "base_terrain_id everywhere", so Barren builds exactly the 100% tag-inert
; wild grass every build before 2026-09-07 produced, on all three cards. It is therefore also
; the reference world: if a Barren start ever stops looking like the old default, the mix
; gating in WorldRoot._ready() has leaked.
;
; The human ruling (2026-09-07 -> D-53, closing the second half of Open Question #10) gave the
; other two cards real terrain and left this one alone. "Barren" is now literally what the name
; says rather than a differently-labelled copy of Meadow Start.

[ext_resource type="Script" path="res://scripts/definitions/world_preset.gd" id="1_schema"]

[resource]
script = ExtResource("1_schema")
id = "barren_start"
display_name = "Barren"
width = 36
depth = 36
base_terrain_id = "wild_grass"
