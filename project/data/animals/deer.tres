; Deer — AnimalDefinition data entry (gdd.md -> Data Schemas / Content Architecture).
; Roster row: roster.md -> Already-Defined Roster | Ruled: decisions.md -> D-43.
; Asset: Quaternius "Ultimate Animated Animal Pack", CC0 1.0 Universal — see
;   project/attribution/sources/quaternius_ultimate_animated_animals.tres.
; Source: source-content/assets/Ultimate Animated Animals - July 2021/glTF/Deer.gltf
;
; SPECIES CHOICE: white-tailed deer (Odocoileus virginianus) — the same pin
; docs/content/cleared-pool-fact-cards.md § Deer commits to, chosen over red deer
; specifically so Deer and Stag do not source the same real animal under two roster
; entries (Stag is red deer, Cervus elaphus).
;
; CAPACITY FIELDS (D-43): capacity_radius = 0 -> the SENTINEL
; `CAPACITY_RADIUS_FOLLOWS_SCOUT`, meaning "equal to scout_radius" (10), not a radius of
; zero. tiles_per_individual = 6, max_individuals = 6 — D-43's decided values, forest-edge
; grazer of open ground, not farm-tolerant.
;
; fact_text is docs/content/cleared-pool-fact-cards.md § Deer's proposed line, transcribed
; verbatim — all four checklist steps PASS there. Per-clause sourcing:
;   "spotted coat ... turned a grayish brown" -> ADW Odocoileus virginianus, "Physical
;   Description" (fawn coloration and molt at first winter).
; https://animaldiversity.org/accounts/Odocoileus_virginianus/
; A companion predation-adjacent sentence in the same ADW paragraph (fawn scent-hiding
; behavior) and a diet-adjacent grazing sentence were both cut during drafting — see the
; source file's Checklist step 4 for the full note.
;
; news_reports intentionally empty — News Report pools for this pool are a separate, later
; purchase (not part of Content Pipeline step 4/5 for this dispatch).
;
; TIERS — RE-SPEC 2026-09-04 (habitat tiers). CONVERTED LAST, deliberately, alongside
; human.tres — both are the roster's two `emits_tags` carriers, so converting them last
; means `HabitatGraph.find_cycle()` first runs green against the fullest possible graph.
;
; PROPOSAL, NOT A DECISION. Every divisor, radius and cap below is this design's own
; first-pass proposal awaiting human sign-off, per the project rule that all tuning values
; are the human's. Source: docs/superpowers/specs/2026-09-04-habitat-tiers-design.md § 9,
; § 12 (OQ-A, ruled 2026-09-04).
;
; `emits_tags = ["deer"]` IS THE OTHER HALF OF THE STAG MECHANISM (see stag.tres): a
; resident deer contributes the `deer` tag to its neighbourhood, and Stag's `deer/4` need
; reads it back — four deer support one stag, expressed with no new machinery at all, the
; same mechanic `people` already uses for the dogs. Adds one edge to the acyclicity check
; (deer -> deer -> stag) — SELF-emission is a population threshold, not a cycle: more deer
; make more deer possible, which terminates because deer also need finite land (see
; `HabitatGraph`'s own doc comment).
;
; TWO TIERS: "base" (`open_grass/5` `forest/4`, gated by `!built<=1` — a distant cottage is
; tolerated, a village is not) and "herd" (the same needs plus `browse/6`, WIDER RADII,
; `!built<=0` — genuinely wild land, no buildings at all — arriving in groups of 3).
;
; The legacy flat fields (habitat_needs / tiles_per_individual / max_individuals) are LEFT
; IN PLACE and are now inert: `effective_tiers()` prefers `tiers` when non-empty. They are
; retained so a rollback is a one-line edit rather than a re-authoring.
[gd_resource type="Resource" script_class="AnimalDefinition" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/definitions/animal_definition.gd" id="1_schema"]
[ext_resource type="PackedScene" path="res://assets/animals/deer/Deer.tscn" id="2_model"]
[ext_resource type="Script" path="res://scripts/definitions/habitat_need.gd" id="3_need"]
[ext_resource type="Script" path="res://scripts/definitions/habitat_limit.gd" id="4_limit"]
[ext_resource type="Script" path="res://scripts/definitions/habitat_tier.gd" id="5_tier"]

[sub_resource type="Resource" id="need_base_grass"]
script = ExtResource("3_need")
tag = "open_grass"
radius = 0
tiles_per_individual = 5

[sub_resource type="Resource" id="need_base_forest"]
script = ExtResource("3_need")
tag = "forest"
radius = 0
tiles_per_individual = 4

[sub_resource type="Resource" id="limit_base_built"]
script = ExtResource("4_limit")
tag = "built"
radius = 0
max_count = 1

[sub_resource type="Resource" id="tier_base"]
script = ExtResource("5_tier")
id = "base"
needs = Array[Resource]([SubResource("need_base_grass"), SubResource("need_base_forest")])
limits = Array[Resource]([SubResource("limit_base_built")])
max_individuals = 4
arrival_group_size = 1

[sub_resource type="Resource" id="need_herd_grass"]
script = ExtResource("3_need")
tag = "open_grass"
radius = 14
tiles_per_individual = 5

[sub_resource type="Resource" id="need_herd_forest"]
script = ExtResource("3_need")
tag = "forest"
radius = 14
tiles_per_individual = 4

[sub_resource type="Resource" id="need_herd_browse"]
script = ExtResource("3_need")
tag = "browse"
radius = 14
tiles_per_individual = 6

[sub_resource type="Resource" id="limit_herd_built"]
script = ExtResource("4_limit")
tag = "built"
radius = 14
max_count = 0

[sub_resource type="Resource" id="tier_herd"]
script = ExtResource("5_tier")
id = "herd"
needs = Array[Resource]([SubResource("need_herd_grass"), SubResource("need_herd_forest"), SubResource("need_herd_browse")])
limits = Array[Resource]([SubResource("limit_herd_built")])
max_individuals = 8
arrival_group_size = 3

[resource]
script = ExtResource("1_schema")
id = "deer"
display_name = "Deer"
habitat_needs = Array[String](["open_grass", "forest"])
personality = "Shy"
avoids = Array[String]([])
farm_tolerant = false
scout_radius = 10
capacity_radius = 0
tiles_per_individual = 6
max_individuals = 6
tiers = Array[Resource]([SubResource("tier_base"), SubResource("tier_herd")])
emits_tags = Array[String](["deer"])
model_scenes = Array[PackedScene]([ExtResource("2_model")])
; fact_text_pool REPLACED by scripts/fact_card_pipeline.py (2026-08-17) -- AWAITING STEP-8 HUMAN SIGN-OFF, not yet reviewed.
fact_text_pool = Array[String](["Every year, male deer grow brand new antlers that start soft and velvety before gradually hardening into strong, branching structures.", "Deer's coats change color with the seasons, turning from reddish-brown in summer to gray-brown in winter. Each year, their fur switches back and forth as the world around them transforms!", "Baby deer called fawns are born with white spots scattered across their coats, but these spots gradually fade and disappear by their first winter.", "Baby deer called fawns can stand and take their first steps within just twenty minutes of being born!"])
news_reports = Array[String]([])
