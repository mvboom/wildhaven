script = ExtResource("1_schema")
id = "house"
display_name = "House"
cost = 15
footprint = Vector2i(1, 1)
allowed_terrain = Array[String](["grass"])
emitted_tags = Array[String](["house"])
model_scenes = Array[PackedScene]([ExtResource("2_model"), ExtResource("3_model"), ExtResource("4_model"), ExtResource("5_model"), ExtResource("6_model"), ExtResource("7_model"), ExtResource("8_model"), ExtResource("9_model"), ExtResource("10_model"), ExtResource("11_model"), ExtResource("12_model"), ExtResource("13_model"), ExtResource("14_model"), ExtResource("15_model"), ExtResource("16_model"), ExtResource("17_model"), ExtResource("18_model"), ExtResource("19_model")])
fact_text = "This simple house is ready to be someone's new home. Plant a field close by, and a family will settle in before long."
