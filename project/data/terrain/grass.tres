[ext_resource type="PackedScene" path="res://assets/terrain/grass_common_tall/GrassCommonTall.tscn" id="3_model"]
[ext_resource type="PackedScene" path="res://assets/terrain/grass_clover/GrassClover.tscn" id="4_model"]
[ext_resource type="PackedScene" path="res://assets/terrain/grass_wispy/GrassWispy.tscn" id="5_model"]

