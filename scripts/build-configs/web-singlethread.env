# Web (single-threaded) build config — read by scripts/build-game.sh.
#
# Same non-Mono-editor requirement as web-threaded.env — see that file's comment. This
# variant exists for hosts/browsers that can't or won't send the COOP/COEP headers
# threading requires (e.g. plain static hosting with no header control) — it runs without
# SharedArrayBuffer, so no special response headers are required to load it, though
# scripts/serve-web-build.py sends them anyway since they're harmless here.

GODOT_BIN="godot/Godot_v4.7-stable_linux.x86_64"
PRESET_NAME="Web (Single-threaded)"
OUTPUT_DIR="builds/web-singlethread"
OUTPUT_FILE="builds/web-singlethread/index.html"
