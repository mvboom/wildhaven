# Desktop (Linux) build config — read by scripts/build-game.sh.
#
# The MONO editor is used here on purpose: Godot 4's Mono/.NET editor CANNOT export to Web
# at all (a hard engine limitation, not a template issue — see web-threaded.env/
# web-singlethread.env for why those targets use a different binary), but it exports every
# other platform fine, and it's the binary already provisioned in this project.

GODOT_BIN="godot/Godot_v4.7-stable_mono_linux.x86_64"
PRESET_NAME="Desktop (Linux)"
OUTPUT_DIR="builds/desktop"
OUTPUT_FILE="builds/desktop/Wildhaven.x86_64"
